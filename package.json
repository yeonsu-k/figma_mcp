{
  "name": "figma_mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tokens:build": "node transform-tokens.js",
    "tokens:watch": "nodemon --watch tokens --ext json --exec \"node transform-tokens.js\"",
    "tokens:clean": "rm -f assets/css/design-tokens.css assets/css/theme-tokens.css public/api/tokens.json tokens/transformed.json tailwind.theme.js",
    "deploy:build": "npm run tokens:build && npm run generate",
    "deploy:preview": "npm run deploy:build && npm run preview",
    "tokens:legacy:build": "node build-tokens.js",
    "tokens:legacy:watch": "nodemon --watch tokens --ext json --exec \"node build-tokens.js\"",
    "tokens:legacy:clean": "rm -f assets/css/theme-tokens.css public/api/tokens.json"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@tailwindcss/vite": "^4.1.6",
    "@types/node": "^20.10.6",
    "nodemon": "^3.0.2",
    "nuxt": "^3.8.0",
    "tailwindcss": "^4.1.6"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.16",
    "@heroicons/vue": "^2.0.18",
    "@pinia/nuxt": "^0.5.1",
    "@tokens-studio/sd-transforms": "^1.3.0",
    "@vueuse/nuxt": "^10.7.0",
    "pinia": "^2.1.7",
    "style-dictionary": "^4.4.0",
    "token-transformer": "^0.0.33",
    "vue-toastification": "^2.0.0-rc.5"
  }
}
